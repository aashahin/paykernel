{
  "name": "@paykernel/gateway-hesabe",
  "version": "0.3.0",
  "description": "Portable Hesabe gateway adapter for @paykernel/core: redirect and embedded checkout, direct Apple Pay, transaction enquiry, refunds, and enquiry-verified webhooks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run --bun build:types && bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "build:types": "bun check -p tsconfig.json && bun ./scripts/build-types.ts",
    "test": "bun test",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.tests.json",
    "typecheck:tests": "bun check -p tsconfig.tests.json",
    "typecheck:types": "bun check -p tsconfig.type-tests.json",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "prepublishOnly": "bun run --bun typecheck:tests && bun run --bun test && bun run --bun build"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@paykernel/core": "^1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@paykernel/testkit": "^1.0.2",
    "@types/bun": "latest",
    "publint": "^0.3.22",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "payments",
    "hesabe",
    "gateway",
    "mena",
    "kuwait",
    "paykernel",
    "typescript"
  ],
  "author": "Abdelrahman Shaheen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/paykernel.git",
    "directory": "packages/gateway-hesabe"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/aashahin/paykernel/tree/main/packages/gateway-hesabe#readme",
  "paymentsSdk": {
    "portable": true
  },
  "bugs": {
    "url": "https://github.com/aashahin/paykernel/issues"
  }
}
