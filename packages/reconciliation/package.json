{
  "name": "@paykernel/reconciliation",
  "version": "0.1.1",
  "description": "Portable reconciliation primitives for @paykernel/core: safe provider lookup, machine-readable drift, decision-only policy, store-backed scheduling, batch reconcile (no queue required).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@paykernel/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "payments",
    "reconciliation",
    "payment-reconciliation",
    "idempotency",
    "drift-detection",
    "paykernel",
    "typescript"
  ],
  "author": "Abdelrahman Shaheen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/paykernel.git",
    "directory": "packages/reconciliation"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/aashahin/paykernel/tree/main/packages/reconciliation#readme",
  "paymentsSdk": {
    "portable": true
  },
  "bugs": {
    "url": "https://github.com/aashahin/paykernel/issues"
  }
}
