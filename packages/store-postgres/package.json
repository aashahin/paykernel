{
  "name": "@paykernel/store-postgres",
  "version": "0.1.1",
  "description": "PostgreSQL durable stores for PayKernel lease-aware idempotency, webhook inbox, and reconciliation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bun-sql": {
      "types": "./dist/bun-sql.d.ts",
      "import": "./dist/bun-sql.js"
    },
    "./postgres-js": {
      "types": "./dist/postgres-js.d.ts",
      "import": "./dist/postgres-js.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/bun-sql.ts ./src/postgres-js.ts ./src/pg.ts ./src/drizzle.ts --outdir ./dist --target node --format esm --packages external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@paykernel/store-contracts": "^0.1.0",
    "@paykernel/sql-foundation": "^0.1.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.29.0",
    "pg": ">=8.11.0",
    "postgres": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "typescript": "^5.9.3",
    "@paykernel/testkit": "^1.0.1"
  },
  "keywords": [
    "payments",
    "postgres",
    "postgresql",
    "idempotency",
    "webhooks",
    "reconciliation",
    "paykernel",
    "typescript",
    "drizzle"
  ],
  "author": "Abdelrahman Shaheen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/paykernel.git",
    "directory": "packages/store-postgres"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/aashahin/paykernel/tree/main/packages/store-postgres#readme",
  "paymentsSdk": {
    "portable": false,
    "runtime": "node-or-bun"
  },
  "bugs": {
    "url": "https://github.com/aashahin/paykernel/issues"
  }
}
