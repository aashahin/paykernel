{
  "name": "@paykernel/routing",
  "version": "0.1.1",
  "description": "Portable safe payment routing policies for @paykernel/core: deterministic select-only gateway choice, money-safe amount ranges, and structurally restricted post-attempt fallback eligibility.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@paykernel/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "payments",
    "routing",
    "payment-routing",
    "gateway-selection",
    "fallback",
    "paykernel",
    "typescript"
  ],
  "author": "Abdelrahman Shaheen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/paykernel.git",
    "directory": "packages/routing"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/aashahin/paykernel/tree/main/packages/routing#readme",
  "paymentsSdk": {
    "portable": true
  },
  "bugs": {
    "url": "https://github.com/aashahin/paykernel/issues"
  }
}
