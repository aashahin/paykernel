{
  "name": "@paykernel/internal-sql-store",
  "version": "0.1.0",
  "private": true,
  "description": "Thin monorepo re-export of @paykernel/sql-foundation. Prefer @paykernel/sql-foundation in new code. Not published.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@paykernel/sql-foundation": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "author": "Abdelrahman Shaheen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/paykernel.git",
    "directory": "internal/sql-store"
  },
  "homepage": "https://github.com/aashahin/paykernel/tree/main/internal/sql-store#readme",
  "paymentsSdk": {
    "portable": true,
    "privateInternal": true
  },
  "bugs": {
    "url": "https://github.com/aashahin/paykernel/issues"
  }
}
